{
  "connector.class": "io.debezium.connector.mysql.MySqlConnector",
  "tasks.max": "1",
  "database.hostname": "mysql-primary",
  "database.port": "3306",
  "database.user": "${env:MYSQL_DEBEZIUM_USER}",
  "database.password": "${env:MYSQL_DEBEZIUM_PASSWORD}",
  "database.server.id": "184054",
  "topic.prefix": "dnmp-admin",
  "database.include.list": "admin",
  "table.include.list": "admin.admin_log",
  "include.schema.changes": "false",
  "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
  "schema.history.internal.kafka.topic": "schema-changes.admin",
  "tombstones.on.delete": "false",
  "snapshot.mode": "no_data"
}
