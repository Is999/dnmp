# php8.2 composer
composer () {
    tty=
    tty -s && tty=--tty
    docker run \
        $tty \
        --interactive \
        --rm \
        --user www-data:www-data \
        --volume ~/dnmp/data/composer:/tmp/composer \
        --volume "$(pwd):/app" \
        --workdir /app \
        dnmp-php82 composer "$@"
}

# php5.6 composer
composer56 () {
