    tty -s && tty=--tty
    docker run \
        $tty \
        --interactive \
        --rm \
        --user www-data:www-data \
        --volume ~/dnmp/data/composer:/tmp/composer \
        --volume "$(pwd):/app" \
        --workdir /app \
        dnmp-php56 composer "$@"
}

# php5.4 composer
composer54 () {
